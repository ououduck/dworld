{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // 开启完整严格模式：undefined/null 检查、隐式 any 报错等，从类型层面拦截常见运行时错误。
    "strict": true,
    // 未使用的局部变量 / 参数直接报错，防止死代码与笔误遗留。
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // 显式声明检查范围：只覆盖源码与构建配置，避免误扫 JS 配置与产物目录。
  "include": [
    "src",
    "components",
    "config",
    "App.tsx",
    "index.tsx",
    "config.ts",
    "vite.config.ts"
  ]
}
